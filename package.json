{
  "name": "my-checklist-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo Scheduling and Checklist System",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "npm run build:shared && npm run build --workspaces --if-present",
    "test": "vitest run",
    "dev:backend": "npm run dev --workspace=apps/backend",
    "dev:frontend": "npm run dev --workspace=apps/frontend",
    "build:shared": "npm run build --workspace=packages/shared"
  },
  "devDependencies": {
    "@types/supertest": "^7.2.1",
    "concurrently": "^8.2.2",
    "supertest": "^7.2.2",
    "typescript": "^5.3.3",
    "vitest": "^5.0.1"
  }
}
